<?xml version="1.0" encoding="utf-8"?>
<!--
    Datenschutz: Cloud-Backup und Geräte-Transfer werden vollständig ausgeschlossen,
    damit Audiodiktate niemals unbeabsichtigt das Gerät verlassen.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
